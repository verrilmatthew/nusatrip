# NusaTrip runs in local demo mode without credentials.
# These integration settings are reserved for future server adapters;
# setting them alone does not enable a provider.
# Never prefix secrets with NEXT_PUBLIC_.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# AI_PROVIDER_API_KEY=
# ROUTING_PROVIDER_API_KEY=
# WEATHER_COMMERCIAL_API_KEY=
